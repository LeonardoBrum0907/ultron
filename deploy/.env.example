# Ultron on the VPS. Copy to deploy/.env (never commit it) and fill it in.
# The bridge reads every variable in the root .env.example too; only the ones
# that matter on a server are listed here.

# --- Domain -----------------------------------------------------------------
# The bridge's public name. Its DNS A record must point at this VPS before the
# first start, or Caddy cannot get the HTTPS certificate.
ULTRON_API_DOMAIN=api.ultron.example.com

# The page's address on Vercel, exactly as the browser shows it (no trailing
# slash). The bridge refuses sockets and requests from any other page.
ULTRON_ALLOWED_ORIGINS=https://ultron.example.com

# --- Access -----------------------------------------------------------------
# Every request reaches the bridge from outside, so it stays shut until this
# is set. Long and random: `openssl rand -base64 32`.
ULTRON_PASSWORD=

# --- Brain ------------------------------------------------------------------
# Claude Code needs a login on the server. One of the two:
#   CLAUDE_CODE_OAUTH_TOKEN — your Claude subscription. Run `claude setup-token`
#     on your PC and paste the token here.
#   ANTHROPIC_API_KEY — an API key, billed per token.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ULTRON_MODEL=claude-sonnet-5-5
# ULTRON_EFFORT=low
# ULTRON_HEAVY_MODEL=claude-opus-5-5
# ULTRON_HEAVY_EFFORT=high
# ULTRON_LANG=pt-BR

# --- Voice ------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# ULTRON_VOICE_ID=

# --- PC-only features -------------------------------------------------------
# Shell (! in the terminal) and write tools would run on this server, not on
# your PC. Leave them off.
# ULTRON_ALLOW_SHELL=0
# ULTRON_ALLOW_WRITES=0

# --- Database ---------------------------------------------------------------
# Nothing in the bridge uses Postgres yet; it is here so it is ready when
# something does. The bridge sees it at DATABASE_URL.
POSTGRES_DB=ultron
POSTGRES_USER=ultron
POSTGRES_PASSWORD=
DATABASE_URL=postgres://ultron:CHANGE_ME@db:5432/ultron
